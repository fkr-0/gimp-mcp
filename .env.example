# GIMP MCP Pro local runtime settings
# Copy to .env for local overrides. New variables use the GIMP_MCP_PRO_ prefix.

GIMP_MCP_PRO_HOST=localhost
GIMP_MCP_PRO_PORT=9877
GIMP_MCP_PRO_TIMEOUT=30
GIMP_MCP_PRO_LONG_TIMEOUT=120
GIMP_MCP_PRO_MAX_MESSAGE_SIZE=104857600
GIMP_MCP_PRO_RECONNECT_DELAYS=0.5,1.0,2.0,4.0,8.0
GIMP_MCP_PRO_LOG_LEVEL=INFO
GIMP_MCP_PRO_DEBUG=false
GIMP_MCP_PRO_USE_LENGTH_PREFIX=true
# GIMP_MCP_PRO_PLUGIN_DIR=/home/user/.config/GIMP/3.2/plug-ins/gimp-mcp-pro
